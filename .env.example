# Dominio canónico (canonical, hreflang, sitemap, OG). Sin barra final.
# Si no se define, se usa "url" de config/site.json.
NEXT_PUBLIC_SITE_URL=

# Formulario de contacto (Resend, API HTTP; portable a Vercel/Cloudflare/Node)
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "24Shoots <web@24shoots.es>"
CONTACT_FROM_EMAIL=
# Destinatario; por defecto contact.email de config/site.json
CONTACT_TO_EMAIL=

# Google Analytics (solo se carga con consentimiento)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
